<Window x:Class="PcAudioStreamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirPulse"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="685" Width="550"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="#202020"
        Foreground="#FFFFFF">

    <Window.Resources>
        <!-- Windows 11 Fluent Button Style -->
        <Style x:Key="Win11SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#323232"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#454545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#292929"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Primary Accent Button Style -->
        <Style x:Key="Win11AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Card (Win11 Settings Header Style) -->
        <Border Grid.Row="0" Background="#2B2B2B" BorderBrush="#373737" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/logo.png" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AirPulse" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="BleStatusText"
                               Text="Initializing BLE &amp; LAN Auto-Discovery..."
                               FontSize="12.5" Foreground="#60CDFF" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 1. System Audio Capture & Behavior Card -->
        <Border Grid.Row="1" Background="#2B2B2B" BorderBrush="#373737" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="System Audio &amp; Background Behavior" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="DeviceComboBox" Grid.Column="0" Height="32" VerticalContentAlignment="Center"
                              Padding="8,0" SelectionChanged="DeviceComboBox_SelectionChanged"/>
                    <Button x:Name="RefreshDevicesBtn" Grid.Column="1" Content="Refresh" Width="78" Height="32" Margin="8,0,0,0"
                            Style="{StaticResource Win11SecondaryButton}" Click="RefreshDevicesBtn_Click"/>
                </Grid>

                <!-- Live Peak Meter -->
                <DockPanel Margin="0,12,0,5">
                    <TextBlock Text="Output level (pre-mute loopback)" FontSize="12" Foreground="#C5C5C5"/>
                </DockPanel>
                <ProgressBar x:Name="PeakMeterBar" Minimum="0" Maximum="100" Value="0" Height="6"
                             Background="#1F1F1F" Foreground="#60CDFF" BorderThickness="0"/>

                <Border Height="1" Background="#353535" Margin="0,12,0,10"/>

                <CheckBox x:Name="MutePcCheckBox"
                          Content="Mute PC speakers while iPhone is streaming (auto-unmute on stop)"
                          IsChecked="True"
                          Foreground="#E5E5E5"
                          FontSize="12.5"
                          Margin="0,0,0,8"
                          Checked="MutePcCheckBox_Changed"
                          Unchecked="MutePcCheckBox_Changed"/>

                <CheckBox x:Name="AutoStartCheckBox"
                          Content="Start automatically in background when Windows starts (close button minimizes to Tray)"
                          IsChecked="True"
                          Foreground="#E5E5E5"
                          FontSize="12.5"
                          Checked="AutoStartCheckBox_Changed"
                          Unchecked="AutoStartCheckBox_Changed"/>
            </StackPanel>
        </Border>

        <!-- 2. iPhone Connection Card -->
        <Border Grid.Row="2" Background="#2B2B2B" BorderBrush="#373737" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="iPhone Receiver Connection" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                <TextBlock x:Name="ClientStatusText"
                           Text="Waiting for iPhone connection..."
                           FontSize="12.5" Foreground="#60CDFF" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TargetIpTextBox" Grid.Column="0" Height="30" VerticalContentAlignment="Center"
                             Background="#1F1F1F" Foreground="#FFFFFF" BorderBrush="#454545"
                             Padding="8,0" Text="" ToolTip="Optional manual iPhone IPv4 address"/>
                    <TextBox x:Name="UdpPortTextBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                             Background="#1F1F1F" Foreground="#FFFFFF" BorderBrush="#454545"
                             Padding="8,0" Margin="8,0,0,0" Text="49152" ToolTip="UDP Port"/>
                    <Button x:Name="ApplyTargetBtn" Grid.Column="2" Content="Set Target" Width="84" Height="30" Margin="8,0,0,0"
                            Style="{StaticResource Win11SecondaryButton}" Click="ApplyTargetBtn_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. Codec & Gain Card -->
        <Border Grid.Row="3" Background="#2B2B2B" BorderBrush="#373737" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Audio Format &amp; Gain" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Codec" FontSize="12" Foreground="#C5C5C5" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CodecComboBox" Height="30" VerticalContentAlignment="Center" SelectionChanged="CodecComboBox_SelectionChanged">
                            <ComboBoxItem Content="Raw PCM 16-bit (48 kHz Lossless)" IsSelected="True"/>
                            <ComboBoxItem Content="Opus (192 kbps Low Bandwidth)"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Frame duration" FontSize="12" Foreground="#C5C5C5" Margin="0,0,0,4"/>
                        <ComboBox x:Name="FrameSizeComboBox" Height="30" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="10 ms (Low Latency)" Tag="10" IsSelected="True"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <DockPanel>
                    <TextBlock Text="Output gain" FontSize="12.5" Foreground="#C5C5C5" Width="95" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VolumeValueText" Text="100%" FontSize="12.5" FontWeight="SemiBold" Foreground="#60CDFF" Width="45" DockPanel.Dock="Right" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="200" Value="100" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Telemetry Footer Card -->
        <Border Grid.Row="4" Background="#2B2B2B" BorderBrush="#373737" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TelemetryText"
                           Text="Status: Ready • 48,000 Hz Stereo"
                           FontSize="12.5" Foreground="#E5E5E5"/>
                <TextBlock Text="Closing this window keeps AirPulse running in the System Tray."
                           FontSize="11.5" Foreground="#9E9E9E" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Primary Action Button -->
        <Button x:Name="StartStopBtn" Grid.Row="5" Height="40"
                Content="Stop Streaming"
                Style="{StaticResource Win11AccentButton}"
                Background="#C42B1C"
                Click="StartStopBtn_Click"/>
    </Grid>
</Window>
