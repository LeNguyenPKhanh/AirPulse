<Window x:Class="PcAudioStreamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirPulse — PC to iPhone Audio Streamer"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="650" Width="560"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/logo.png" Width="46" Height="46" Margin="0,0,14,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AirPulse • PC Audio Streamer" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock x:Name="BleStatusText"
                               Text="Initializing BLE &amp; LAN Auto-Discovery..."
                               FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Audio Source Selection -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="1. Windows System Audio Source (WASAPI Loopback)" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="DeviceComboBox" Grid.Column="0" Height="34" VerticalContentAlignment="Center" Padding="8,0" SelectionChanged="DeviceComboBox_SelectionChanged"/>
                    <Button x:Name="RefreshDevicesBtn" Grid.Column="1" Content="Refresh" Width="76" Height="34" Margin="8,0,0,0"
                            Background="#334155" Foreground="White" BorderThickness="0" Click="RefreshDevicesBtn_Click"/>
                </Grid>

                <!-- Live Peak Meter -->
                <TextBlock Text="Live Audio Output Level" FontSize="11.5" Foreground="#94A3B8" Margin="0,12,0,4"/>
                <ProgressBar x:Name="PeakMeterBar" Minimum="0" Maximum="100" Value="0" Height="10"
                             Background="#0F172A" Foreground="#22C55E" BorderThickness="0"/>

                <!-- Mute PC Speaker Checkbox -->
                <CheckBox x:Name="MutePcCheckBox"
                          Content="Mute PC Speakers while streaming to iPhone (Auto-Restore on Stop)"
                          IsChecked="True"
                          Foreground="#38BDF8"
                          FontWeight="Medium"
                          Margin="0,10,0,0"
                          Checked="MutePcCheckBox_Changed"
                          Unchecked="MutePcCheckBox_Changed"/>
            </StackPanel>
        </Border>

        <!-- iPhone Connection & Pairing -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="2. iPhone Receiver Endpoint (Auto BLE / Wi-Fi UDP)" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                <TextBlock x:Name="ClientStatusText"
                           Text="Waiting for iPhone one-tap connection (or enter iPhone IP below)..."
                           FontSize="12.5" Foreground="#38BDF8" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TargetIpTextBox" Grid.Column="0" Height="32" VerticalContentAlignment="Center"
                             Padding="8,0" Text="" ToolTip="Optional: Manual iPhone IPv4 Address"/>
                    <TextBox x:Name="UdpPortTextBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center"
                             Padding="8,0" Margin="8,0,0,0" Text="49152" ToolTip="UDP Port"/>
                    <Button x:Name="ApplyTargetBtn" Grid.Column="2" Content="Set Target" Width="84" Height="32" Margin="8,0,0,0"
                            Background="#334155" Foreground="White" BorderThickness="0" Click="ApplyTargetBtn_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Codec, Frame Latency & Gain Controls -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="3. Low-Latency Codec &amp; Mixing Controls" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Audio Codec" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CodecComboBox" Height="32" VerticalContentAlignment="Center" SelectionChanged="CodecComboBox_SelectionChanged">
                            <ComboBoxItem Content="Raw PCM 16-bit (48kHz Crystal Clear - Recommended)" IsSelected="True"/>
                            <ComboBoxItem Content="Opus (192 kbps Compressed)"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="UDP Frame Pacing" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <ComboBox x:Name="FrameSizeComboBox" Height="32" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="7.5 ms (Single-MTU Smooth Pacing)" Tag="7" IsSelected="True"/>
                            <ComboBoxItem Content="10 ms (High Stability)" Tag="10"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Volume Gain Slider -->
                <DockPanel>
                    <TextBlock Text="PC Stream Gain:" FontSize="12" Foreground="#94A3B8" Width="105" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VolumeValueText" Text="100%" FontSize="12" Foreground="#E2E8F0" Width="45" DockPanel.Dock="Right" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="200" Value="100" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Telemetry Footer -->
        <Border Grid.Row="4" Background="#1E293B" CornerRadius="10" Padding="14" Margin="0,0,0,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TelemetryText"
                           Text="Status: Ready • 48,000 Hz Stereo • Background Keep-Alive Enabled"
                           FontSize="12.5" Foreground="#CBD5E1"/>
                <TextBlock Text="Tip: Open the iOS Receiver app with 'Mix With Others' enabled to hear PC audio alongside iPhone apps &amp; locked screen."
                           FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Primary Action Button -->
        <Button x:Name="StartStopBtn" Grid.Row="5" Height="48"
                Content="START STREAMING TO IPHONE"
                FontSize="15" FontWeight="Bold"
                Background="#0284C7" Foreground="White" BorderThickness="0"
                Click="StartStopBtn_Click"/>
    </Grid>
</Window>
